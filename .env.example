# Copy this file to .env for local development. Never commit a real .env file.
# .env is already listed in .gitignore.
#
# Nothing in this file should ever be a production secret, mainnet private key,
# or seed phrase. See docs/SECURITY.md.

# Solana cluster to use for local development and testing (devnet only for now)
SOLANA_CLUSTER=devnet

# Public RPC endpoint for devnet (replace with your own provider if you have one)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Placeholder for a future DEVNET-ONLY program id once one exists. Do not put a
# mainnet program id here until docs/ROADMAP.md's Phase 3 is human-approved.
OFA_DEVNET_PROGRAM_ID=

# Placeholder for the reward asset mint used in devnet testing (SOL has no mint
# address; this is only relevant once/if testing a USDC-like reward asset).
DEVNET_REWARD_ASSET_MINT=

# Frontend build-time flag: keep true until real on-chain data is wired up.
NEXT_PUBLIC_USE_MOCK_DATA=true
